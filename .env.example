# --- Database ---
# Postgres connection string. Get one from Neon / Supabase / local.
DATABASE_URL=postgres://user:pass@host:5432/tinypa

# --- Auth.js ---
# Run: openssl rand -base64 32
AUTH_SECRET=
# In production this should be the public origin, e.g. https://tinypa.example.com
AUTH_URL=http://localhost:3000
# Same value, exposed client-side for deep links in emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (Resend) ---
# https://resend.com/api-keys
RESEND_API_KEY=
# Any verified sender. For dev you can use the Resend sandbox: onboarding@resend.dev
MAIL_FROM="TinyPA <onboarding@resend.dev>"

# --- LLM (default Gemini; override via LLM_BASE_URL for any OpenAI-compat provider) ---
# Get a key from https://ai.google.dev/  (free tier: 15 RPM / 1500 RPD).
# Used for both chat (extract / digest) and embedding.
LLM_API_KEY=

# Defaults point at Gemini's OpenAI-compat endpoint. Override only if you
# want a different provider (Groq, OpenAI, ...).
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_EXTRACT_MODEL=gemini-flash-latest
# LLM_DIGEST_MODEL=gemini-flash-latest

# Embedding goes to Gemini's native API (not OpenAI-compat). Reuses
# LLM_API_KEY unless you set LLM_EMBED_API_KEY.
# LLM_EMBED_API_KEY=
# LLM_EMBED_MODEL=gemini-embedding-001

# Extra tuning for the extract path (some providers are slow with streaming
# or large max_tokens — these knobs let you adjust without redeploying).
# LLM_EXTRACT_STREAM=false          # disable SSE streaming, wait for full response
# LLM_EXTRACT_MAX_TOKENS=512        # shorter cap = less total work for the model

# --- Cron ---
# Any strong random string. Used to authenticate calls to /api/cron/*.
# Run: openssl rand -hex 32
CRON_SECRET=

# --- Upstash Redis (rate limit + daily quota) ---
# Provision via Vercel Dashboard -> Storage -> Add -> Upstash -> Redis.
# Vercel auto-injects these per environment (Production / Preview / Development).
# Locally: `vercel env pull` writes them into .env.local.
#
# Vercel Marketplace may inject either naming (legacy Vercel KV prefix or
# native Upstash prefix); the code tries UPSTASH_* first then falls back to KV_*.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional limit overrides (defaults shown).
# TINYPA_IP_AUTH_LIMIT=20          # magic-link requests per IP per hour
# TINYPA_EMAIL_AUTH_LIMIT=5        # magic-link requests per email per 10 min
# TINYPA_BURST_MSG_LIMIT=30        # POST /api/messages per user per minute
# TINYPA_DAILY_MSG_LIMIT=200       # messages per user per local day
